
import streamlit as st
from datetime import datetime

st.title("BMI Calculator and Diet Planner")

# Navigation
page = st.sidebar.selectbox(
    "Choose a Page",
    ["BMI Calculator", "Saved Records"]
)

if page == "BMI Calculator":

    st.header("Enter Your Details")

    name = st.text_input("Enter your name")
    age = st.number_input("Enter your age", min_value=1, max_value=120, value=26)
    feet = st.number_input("Height - Feet", min_value=0, max_value=8, value=5)
    inches = st.number_input("Additional Inches", min_value=0, max_value=11, value=0)
    weight = st.number_input("Weight in kg", min_value=1.0, max_value=300.0, value=60.0)

    if st.button("Calculate BMI"):

        total_inches = (feet * 12) + inches
        height = total_inches * 0.0254

        if name.strip() == "":
            st.error("Please enter your name.")

        elif height <= 0:
            st.error("Please enter a valid height.")

        else:
            bmi = weight / (height * height)

            st.subheader("Your BMI Result")
            st.write("Name:", name)
            st.write("Age:", age)
            st.write("BMI:", round(bmi, 2))

            category = ""

            if age < 20:
                category = "Age-specific assessment required"
                st.warning(
                    "Adult BMI categories are not suitable for people under 20. "
                    "BMI should be assessed using age-specific growth charts."
                )

            elif bmi < 18.5:
                category = "Underweight"
                st.info("Category: Underweight")

                st.subheader("Suggested Diet Chart")
                st.write("""
                - Breakfast: Oats with banana and nuts
                - Lunch: Rice or roti, dal, vegetables and eggs or paneer
                - Snack: Fruit and a handful of nuts
                - Dinner: Roti, dal and vegetables
                - Tip: Add nutritious, energy-rich foods gradually.
                """)

            elif bmi < 25:
                category = "Healthy Weight"
                st.success("Category: Healthy Weight")

                st.subheader("Suggested Diet Chart")
                st.write("""
                - Breakfast: Idli, dosa or oats with protein
                - Lunch: Rice or roti, dal and vegetables
                - Snack: Fruit, nuts or roasted chana
                - Dinner: Roti or rice with vegetables and protein
                - Tip: Maintain balanced meals and regular activity.
                """)

            elif bmi < 30:
                category = "Overweight"
                st.warning("Category: Overweight")

                st.subheader("Suggested Diet Chart")
                st.write("""
                - Breakfast: Vegetable oats or idli with sambar
                - Lunch: Moderate rice or roti, dal and vegetables
                - Snack: Fruit or roasted chana
                - Dinner: Roti, vegetables and a protein source
                - Tip: Focus on balanced portions, not crash diets.
                """)

            else:
                category = "Obesity"
                st.warning("Category: Obesity")

                st.subheader("Suggested Diet Chart")
                st.write("""
                - Breakfast: Vegetable oats or eggs with whole-grain toast
                - Lunch: Rice or roti, dal, vegetables and protein
                - Snack: Fruit or unsweetened yogurt
                - Dinner: Roti, vegetables and a protein source
                - Tip: Consider a personalised plan from a qualified dietitian.
                """)

            # Save the assessment to a text file
            record = (
                f"Date: {datetime.now()}\n"
                f"Name: {name}\n"
                f"Age: {age}\n"
                f"Height: {feet} feet {inches} inches\n"
                f"Weight: {weight} kg\n"
                f"BMI: {round(bmi, 2)}\n"
                f"Category: {category}\n"
                f"{'-' * 35}\n"
            )

            with open("bmi_records.txt", "a", encoding="utf-8") as file:
                file.write(record)

            st.success("Your assessment has been saved!")


elif page == "Saved Records":

    st.header("Saved BMI Records")

    try:
        with open("bmi_records.txt", "r", encoding="utf-8") as file:
            records = file.read()

        if records:
            st.text(records)
        else:
            st.info("No records found.")

    except FileNotFoundError:
        st.info("No saved records yet. Calculate your BMI first.")
